/// UPDATE

use ("mundial2026")
db.estadios.updateOne(

{nombre : "estadio de Mexico " , capacidad : 5}, // que es lo que quiero cambiar 
{ $set: {nombre : "estadio de Mexico centro"}} // que se actualiza 
);

/// eliminar campo

use ("mundial2026")
db.estadios.updateOne(
{nombre : "estadio de Mexico " , capacidad : 5}, 
{ $unset: {nombre : ""}} // Eliminar campo 
);



//todos los sitios que pertenezcan chicago con mas de 5 años de antiguedad 
use ("sample_airbnb")
db.sample_airbnb.find({
$and :[
{ edad: {$gte: 18 } }, //edad mayor o igual = $gte
{ ciudad: "Madrid"}

]  
});









